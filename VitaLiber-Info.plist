<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 三部件版本信息（本仓库版本纪律，dev-pm-spec §9.3 / function FR22.8）：
         CFBundleShortVersionString = GitHub 最高 Release 版本（去 v，如 0.0.1）
         CFBundleVersion            = CI 构建序号（github.run_number，如 012）
         VitaLiberBuildHash         = 提交哈希（8 字符短哈希）
         三者由 CI 在 xcodebuild 时以 MARKETING_VERSION / CURRENT_PROJECT_VERSION /
         VITA_LIBER_CODE_HASH 注入；本地构建回落 project.yml 默认值。
         GENERATE_INFOPLIST_FILE=YES 会与本文件合并生成最终 Info.plist。 -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>VitaLiberBuildHash</key>
    <string>$(VITA_LIBER_CODE_HASH)</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- 隐私用途声明（Apple 处理构建时强制校验，缺任一键 build 即 FAILED，code 90683）：
         SFSpeechRecognizer → NSSpeechRecognitionUsageDescription；
         语音输入麦克风 → NSMicrophoneUsageDescription；
         拍摄病历文档 → NSCameraUsageDescription；
         相册选图 → NSPhotoLibraryUsageDescription；
         门禁/敏感媒体生物识别（V3.56 LocalAuthGateUnlocker）→ NSFaceIDUsageDescription——
         缺失时系统对 App 静默禁用 Face ID，deviceOwnerAuthentication 退回纯密码键盘。 -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>语音识别用于在您允许时将语音输入转换为文字，以便录入用药和症状信息。所有识别均在设备端完成。</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>麦克风用于语音输入与语音识别，所有音频均只在设备端处理，不会上传。</string>
    <key>NSCameraUsageDescription</key>
    <string>相机用于拍摄病历、处方等文档图片，以便识别与归档。</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>相册用于选择病历、处方等文档图片，以便识别与归档。</string>
    <key>NSFaceIDUsageDescription</key>
    <string>面容 ID 用于解锁青囊书并保护敏感医疗资料，仅在你主动验证时使用。</string>
    <!-- F16 只读接入 Apple 健康（FR16.1）：仅在你授权后读取指标，不写入、不入诊断逻辑 -->
    <key>NSHealthShareUsageDescription</key>
    <string>在您授权后，只读读取健康 App 中的睡眠、心率、血氧、呼吸率与步数，用于本地观察提示。数据仅在本机处理。</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
