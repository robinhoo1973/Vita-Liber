# ── 默认全部私有（业主指令）：仅白名单入库 ──
/*
!/.github/
!/.gitignore
!/README.md
!/README.zh-CN.md
!/README.zh-Hant.md
!/CoreKit/
!/App/
!/Resources/
!/design/
!/Tests/
!/UITests/
!/project.yml
!/VitaLiber-Info.plist

# Swift/SPM 构建产物（编译非必需，绝不入库）
.build/
.swiftpm/
DerivedData/
Build/
*.xcresult
*.xcodeproj

# 安全兜底：任何密钥/证书/本地环境文件
*.p8
*.p12
*.mobileprovision
*.cer
.env*
secrets*
**/Secrets*.swift

# Python 管线缓存
__pycache__/
