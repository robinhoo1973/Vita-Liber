# 精简模式（业主 2026-09-29 裁决）：显式规则忽略，无 deny-all；扫描根契约见 tech-spec §9/ADR-033（L0 因 ERR#27 暂红，解耦待 Q2）
# Swift/SPM 构建产物（编译非必需，绝不入库）
.build/
.swiftpm/
.superpowers/
DerivedData/
Build/
*.xcresult
*.xcodeproj

# 安全兜底：任何密钥/证书/本地环境文件
*.p8
*.p12
*.mobileprovision
*.cer
.env*
secrets*
**/Secrets*.swift
*.pem
*.key
id_*
.netrc

# Python 管线缓存
__pycache__/
*.pyc

# 医疗数据 Go 工具链（业主 2026-09-27：源码已迁往私仓 robinhoo1973/robinhoo-pipelines
# 的 tasks/vita-liber/medical-data/，公开仓不再保留副本——整目录防误收，勿重新入库）
# ASR权重由钉版清单在构建机取得；清单与许可证入库，运行时全部随包。
/Resources/ASRModels/zipformer/
/Resources/ASRModels/dolphin/
/Resources/ASRModels/whisper/
/Resources/ASRModels/silero/
/Resources/ASRModels/qwen3/
/Resources/ASRModels/resolved-manifest.json
# T2 本机 LLM（业主 2026-09-17 定：随包内置）——GGUF 大文件不入库，
# 由 materialize-llama-model.py 按 catalog.json sha256 校验取模
/Resources/LLMModels/*.gguf

# OCR 真实单据夹具（业主脱敏样本，CI 侧投放，不入库）——识别基线双轨（round3 C4 裁定）
/CoreKit/Tests/CoreKitTests/Fixtures/ocr/real/

# graphify 知识图谱产物（本机检索工件,不入库;2026-10-10 业主指令）
graphify-out/
