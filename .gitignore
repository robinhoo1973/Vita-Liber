# ── 默认全部私有（业主指令）：仅白名单入库 ──
/*
!/.github/
!/.gitignore
!/README.md
!/README.zh-CN.md
!/README.zh-Hant.md
!/CoreKit/
!/App/
!/Resources/
!/design/
!/Tests/
!/UITests/
!/project.yml
!/VitaLiber-Info.plist
# F16 HealthKit entitlements（project.yml entitlements.path 引用）：与 Info.plist
# 同等是构建必需配置，必须在库（CI 上由 xcodegen 从 project.yml properties 重生成，
# 本地文件若不入库会成为与 project.yml 双真相源、静默漂移）。非密钥文件。
!/VitaLiber.entitlements
# 运行时资源下载目录（业主 2026-09-12 决定）：只跟踪索引与发布脚本；
# 模型二进制（*.zip/*.onnx 等）不走 Git，经 GitHub Releases / 对象存储分发。
!/downloads/
/downloads/**/*.zip
/downloads/**/*.onnx
/downloads/**/*.tar
/downloads/**/*.tar.gz

# Swift/SPM 构建产物（编译非必需，绝不入库）
.build/
.swiftpm/
DerivedData/
Build/
*.xcresult
*.xcodeproj

# 安全兜底：任何密钥/证书/本地环境文件
*.p8
*.p12
*.mobileprovision
*.cer
.env*
secrets*
**/Secrets*.swift

# Python 管线缓存
__pycache__/

# ASR权重由钉版清单在构建机取得；清单与许可证入库，运行时全部随包。
/Resources/ASRModels/zipformer/
/Resources/ASRModels/dolphin/
/Resources/ASRModels/whisper/
/Resources/ASRModels/silero/
/Resources/ASRModels/qwen3/
/Resources/ASRModels/resolved-manifest.json
