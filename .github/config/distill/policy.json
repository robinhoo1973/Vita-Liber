    "calibrate": {
      "mpsFallback": "cpu",
      "lossRelTolerance": 0.05
    }
  },
  "noise": {
    "version": "2.1",
    "_bandComment": "字级 CER 目标(校准对象=4-8 字 span);alpha 席终案,现实锚定:OCR 手机翻拍 3-13.5%/ASR 9-16%",
    "bandTargets": {
      "clean": 0.0,
      "light": 0.02,
      "medium": 0.05,
      "heavy": 0.1,
      "extreme": 0.18
    },
    "spanDamageTargets": {
      "clean": 0.0,
      "light": 0.11,
      "medium": 0.26,
      "heavy": 0.47,
      "extreme": 0.7
    },
    "spanDamageTolerance": {
      "clean": 0.0,
      "light": 0.03,
      "medium": 0.04,
      "heavy": 0.05,
      "extreme": 0.05
    },
    "spanDamageMinSpans": 1000,
    "trainMix": {
      "clean": 0.15,
      "light": 0.3,
      "medium": 0.3,
      "heavy": 0.17,
      "extreme": 0.08
    },
    "labelPreservingCerMax": 0.2,
    "generators": {
      "positionSampler": "textnoisr(BSD-2)",
      "confusionSource": "unihan-pycorrector",
      "optional": "scrambledtext(MIT,自举对照轨)"
    },
    "version_comment": "2.1=长度补偿 L_eff=max(len,7)(2026-10-08:R0 首测 0.73× → 锚 6 实测 → 锚 7 反推落点 0.112/0.266/0.485/0.707 全入容差)"
  },
  "training": {
    "_comment": "CPU 分块训练链(2026-10-09 无私仓/无 GPU;公开仓 ubuntu 4vCPU/6h job)。chain_chain 状态机三重闸:失败即停/maxChunks/零进度;产物=Release llama-models(draft,autoPromote=false)。",
    "chunkMinutes": 350,
    "chainEnabled": true,
    "maxChunks": {
      "train-encoder": 8,
      "train-sft": 40
