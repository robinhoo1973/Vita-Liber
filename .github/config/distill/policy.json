    "requiredKinds": [
      "prescription",
      "medication",
      "encounter",
      "metric_sample",
      "diagnosis",
      "exam_report",
      "claim_item",
      "health_exam",
      "clinical_conclusion",
      "treatment_record",
      "immunization"
